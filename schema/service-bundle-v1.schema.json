{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 32
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 32
          },
          "image": {
            "type": "string",
            "pattern": "^.+@sha256:[0-9a-fA-F]{64}$"
          },
          "supported_hosts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "os": {
                  "enum": [
                    "linux",
                    "macos"
                  ]
                },
                "architecture": {
                  "enum": [
                    "amd64",
                    "arm64"
                  ]
                }
              },
              "required": [
                "os",
                "architecture"
              ],
              "additionalProperties": false
            },
            "uniqueItems": true
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 32
            },
            "uniqueItems": true
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "maxLength": 32
                },
                "container_port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "host_port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "publish_host": {
                  "type": "boolean"
                },
                "host_bind": {
                  "const": "127.0.0.1"
                }
              },
              "required": [
                "name",
                "container_port"
              ],
              "additionalProperties": false
            },
            "uniqueItems": true
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "integer",
                "boolean",
                "null"
              ]
            }
          },
          "secrets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "maxLength": 32
                },
                "target_env": {
                  "type": "string",
                  "pattern": "^[A-Z_][A-Z0-9_]*$"
                },
                "source": {
                  "enum": [
                    "generated",
                    "operator"
                  ]
                }
              },
              "required": [
                "name",
                "target_env",
                "source"
              ],
              "additionalProperties": false
            },
            "uniqueItems": true
          },
          "state": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "maxLength": 32
                },
                "mount_path": {
                  "type": "string",
                  "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]*$"
                }
              },
              "required": [
                "name",
                "mount_path"
              ],
              "additionalProperties": false
            },
            "uniqueItems": true
          },
          "readiness": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "tcp",
                  "http"
                ]
              },
              "port": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "maxLength": 32
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "interval_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "retries": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "type",
              "port"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "http"
                    }
                  }
                },
                "then": {
                  "required": [
                    "path"
                  ]
                }
            },
            {
              "if": {
                "properties": {
                  "publish_host": {
                    "const": true
                  }
                },
                "required": [
                  "publish_host"
                ]
              },
              "then": {
                "required": [
                  "host_bind"
                ]
              }
              }
            ]
          },
          "resources": {
            "type": "object",
            "properties": {
              "cpu_millis": {
                "type": "integer",
                "minimum": 1
              },
              "memory_bytes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "image",
          "supported_hosts",
          "ports",
          "readiness"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "name",
    "version",
    "description",
    "components"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lerd.sh/schemas/service-bundle-v1.schema.json",
  "title": "Lerd service bundle v1"
}
